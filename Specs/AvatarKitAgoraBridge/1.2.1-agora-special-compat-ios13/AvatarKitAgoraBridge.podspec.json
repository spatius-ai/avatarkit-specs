{
  "name": "AvatarKitAgoraBridge",
  "version": "1.2.1-agora-special-compat-ios13",
  "summary": "ObjC++ bridge exposing Agora's encoded-frame observer to Swift",
  "description": "Wraps Agora's C++ IVideoEncodedFrameObserver into a Swift-callable\nblock. Kept as a standalone pod so it compiles as its own Clang\nmodule (`import AvatarKitAgoraBridge`), matching the SPM target layout.",
  "homepage": "https://github.com/spatius-ai/avatarkit-ios-rtc",
  "license": {
    "type": "Proprietary",
    "file": "LICENSE"
  },
  "authors": {
    "Spatius": "hello@spatialwalk.net"
  },
  "platforms": {
    "ios": "13.0"
  },
  "source": {
    "git": "https://github.com/spatius-ai/avatarkit-ios-rtc.git",
    "tag": "v1.2.1-agora-special-compat-ios13"
  },
  "source_files": "AvatarKitRTC/Sources/AvatarKitAgoraBridge/**/*.{h,mm}",
  "public_header_files": "AvatarKitRTC/Sources/AvatarKitAgoraBridge/include/*.h",
  "requires_arc": true,
  "dependencies": {
    "AgoraRtcEngine_Special_iOS": [
      "~> 4.5.0.BASIC"
    ]
  },
  "pod_target_xcconfig": {
    "CLANG_CXX_LANGUAGE_STANDARD": "c++17",
    "CLANG_CXX_LIBRARY": "libc++"
  }
}
